diagnostics/*snapshot*.jsonl

# Vendored third-party JHora reference library — not our source, kept local only
PyJHora-main/

# Stage 2 router classification log — local diagnostic output, not source
diagnostics/calc_router_stage2.log

# S66 F5: local dogfood capture — derived text only, never committed
# (no-storage lock ruling 2026-07-12)
diagnostics/dogfood_capture*.md

# Ephemeral diagnostics — overwrite-only run log and archived dogfood captures,
# never source; committed by mistake in 6c4ee8f, untracked same-session
diagnostics/archive/
diagnostics/latest_run.md

# Palm/hand test images — no-storage architecture + privacy, local only (S94)
data/test_images/
diagnostics/qa_capture/

# Kundli PDFs fetched by scripts/astrosage_kundli_fetcher.py (manual runs and
# the frontend "Fetch Kundli Online" option) contain real birth data — same
# no-storage-lock privacy ruling as diagnostics/qa_capture/ above.
diagnostics/kundli_fetch_test/
diagnostics/kundli_fetch_cache/

# S129: frozen qa_capture fixture contains a real chart (Sulabh's, oracle-
# verified) — same no-storage-lock privacy ruling as diagnostics/qa_capture/
# above, applied to the tests/fixtures/ copy. Repo is public (verified S129):
# never commit. Kept on local disk only; tests/astro/test_replay_capture.py
# needs it present locally and will fail without it (known, accepted cost).
tests/fixtures/qa_captures/

# S129: planner decision log, runtime by-product of dogfood/test runs, not a
# deliverable — same class as diagnostics/calc_router_stage2.log above.
diagnostics/planner_decisions.jsonl

# S129: pre-rebuild ChromaDB backup, 135MB of generated binary index files —
# same "ChromaDB — generated locally" class as data/chroma_db/ above, just
# under a path that dodged that rule. Never commit; local disk only.
data/_backup/

# S147: per-chart static fact store (agent/astro/fact_store.py). One file per
# birth combination, holding real birth-data-derived facts — same privacy
# ruling as the kundli / qa_capture caches above. Public repo: never commit;
# local disk only. (No-storage lock was reversed S147 for local multi-user
# caching, NOT for committing users' charts.)
data/fact_cache/

# S149 -- PER-CHART DATED FACT CACHE (timeline_store.py). Same privacy ruling as
# data/fact_cache/ above: keyed by chart identity and derived from real birth
# details, so it is local disk only and never committed.
# PROVENANCE: the S147 session log lists ".gitignore (data/timeline_cache/)" as
# edited and its Locked Decision states both caches are gitignored -- but the
# entry was never actually written to this file. Found S149 by grep. The store has
# shipped since S147 with its output committable; adding it now closes that.
data/timeline_cache/

# S149 -- SHARED EPHEMERIS WINDOW CACHE (ephemeris_cache.py). Ignored because it
# is a DERIVED BUILD ARTIFACT, not because it is sensitive: unlike the two caches
# above it contains NO birth data at all, only sky events over a date range, which
# is what lets one file serve every chart on a deployment. Rebuilt in 0.44s.
data/ephemeris_cache/

# transient pytest / run logs (overwritten each run; evidence lives in *.md)
diagnostics/*.log
diagnostics/**/*.log
